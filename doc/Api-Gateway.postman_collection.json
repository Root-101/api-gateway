      "item": [
        {
          "name": "login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway-url}}/{{gateway-admin-path}}/auth/login",
              "host": [
                "{{gateway-url}}"
              ],
              "path": [
                "{{gateway-admin-path}}",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{gateway-username}}\",\n    \"password\": \"{{gateway-password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('returns a token', () => {",
                  "    pm.expect(r.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(r.expires_in).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set('login-token', r.token);"
                ]
              }
            }
          ]
        },
