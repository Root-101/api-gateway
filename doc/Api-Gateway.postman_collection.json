                ]
              }
            }
          ]
        },
        {
          "name": "all",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway-url}}/{{gateway-admin-path}}/routes",
              "host": [
                "{{gateway-url}}"
              ],
              "path": [
                "{{gateway-admin-path}}",
                "routes"
              ]
            },
            "description": "Also saves the ids of the routes created by `create` and `create-all` for the next requests."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const isRoute = (r) => {",
                  "    pm.expect(r).to.have.all.keys('id', 'name', 'path', 'uri', 'rewrite_path', 'description', 'created_at');",
                  "    pm.expect(r.id).to.match(/^[0-9a-f-]{36}$/);",
                  "};",
                  "",
                  "const routes = pm.response.json();",
                  "pm.test('every route has the response shape', () => routes.forEach(isRoute));",
                  "const byName = (name) => routes.find(r => r.name === name);",
                  "const run = pm.collectionVariables.get('run');",
                  "pm.test('created routes are listed', () => {",
                  "    const created = byName(`test-dev-${run}`);",
                  "    pm.expect(created, 'route of `create`').to.exist;",
                  "    pm.expect(created.rewrite_path).to.eql({replace_from: `/test-service-${run}/`, replace_to: '/'});",
                  "    pm.expect(byName(`test-dev-a-${run}`), 'route a of `create-all`').to.exist;",
                  "    pm.expect(byName(`test-dev-b-${run}`).rewrite_path, 'route b without rewrite').to.be.null;",
                  "});",
                  "//ids for the next requests",
                  "pm.collectionVariables.set('route-id', byName(`test-dev-${run}`).id);",
                  "pm.collectionVariables.set('route-id-a', byName(`test-dev-a-${run}`).id);",
                  "pm.collectionVariables.set('route-id-b', byName(`test-dev-b-${run}`).id);"
                ]
              }
            }
          ]
        },
        {
          "name": "get",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway-url}}/{{gateway-admin-path}}/routes/{{route-id}}",
              "host": [
                "{{gateway-url}}"
