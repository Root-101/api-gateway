            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const run = pm.collectionVariables.get('run');",
                  "pm.test('route data', () => {",
                  "    pm.expect(r.id).to.eql(pm.collectionVariables.get('route-id'));",
                  "    pm.expect(r.name).to.eql(`test-dev-${run}`);",
                  "    pm.expect(r.path).to.eql(`/test-service-${run}/**`);",
                  "    pm.expect(r.uri).to.eql('http://localhost:8081');",
                  "    pm.expect(r.rewrite_path.replace_from).to.eql(`/test-service-${run}/`);",
                  "    pm.expect(r.rewrite_path.replace_to).to.eql('/');",
                  "    pm.expect(r.order).to.eql(0);",
                  "    pm.expect(r.methods).to.eql([]);",
                  "    pm.expect(r.description).to.eql('A test route');",
                  "    pm.expect(new Date(r.created_at).getTime()).to.not.be.NaN;",
                  "});"
                ]
              }
            }
          ]
        },
