          "name": "search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway-url}}/{{gateway-admin-path}}/http-log/search",
              "host": [
                "{{gateway-url}}"
              ],
              "path": [
                "{{gateway-admin-path}}",
                "http-log",
                "search"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"page\": 0,\n    \"size\": 20,\n    \"query\": \"\",\n    \"from_date\": \"{{logs-from}}\",\n    \"to_date\": \"{{logs-to}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "//last hour (the requests of this run included)",
                  "const now = Date.now();",
                  "pm.collectionVariables.set('logs-from', new Date(now - 60 * 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('logs-to', new Date(now + 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('page shape', () => {",
                  "    pm.expect(page).to.have.all.keys('page', 'size', 'total_pages', 'total_elements', 'page_content');",
                  "    pm.expect(page.page).to.eql(0);",
                  "    pm.expect(page.page_content.length).to.be.at.most(20);",
                  "});",
                  "pm.test('log shape', () => {",
                  "    pm.expect(page.total_elements, 'requests of this run are logged').to.be.above(0);",
                  "    page.page_content.forEach(log => {",
                  "        pm.expect(log).to.include.all.keys('id', 'source_ip', 'requested_at', 'user_agent', 'http_method', 'path', 'response_code', 'request_duration', 'route');",
                  "        pm.expect(log.response_code).to.be.a('number');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "search - invalid response code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway-url}}/{{gateway-admin-path}}/http-log/search",
              "host": [
                "{{gateway-url}}"
              ],
              "path": [
                "{{gateway-admin-path}}",
                "http-log",
                "search"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"page\": 0,\n    \"size\": 20,\n    \"response_code\": \"abc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('body: response_code must be a number', () => pm.expect(pm.response.text()).to.include('response_code must be a number'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
