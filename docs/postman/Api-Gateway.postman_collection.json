                  "",
                  "const routes = pm.response.json();",
                  "pm.test('every route has the response shape', () => routes.forEach(isRoute));",
                  "const byId = (id) => routes.find(r => r.id === id);",
                  "pm.test('created routes are listed', () => {",
                  "    pm.expect(byId(pm.collectionVariables.get('route-id')), 'route of `create`').to.exist;",
                  "    pm.expect(byId(pm.collectionVariables.get('route-id-a')), 'route a of `create-all`').to.exist;",
                  "    pm.expect(byId(pm.collectionVariables.get('route-id-b')), 'route b of `create-all`').to.exist;",
                  "});"
                ]
              }
            }
          ]
