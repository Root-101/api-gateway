          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "const run = pm.collectionVariables.get('run');",
                  "pm.test('returns the created route', () => {",
                  "    pm.expect(r.id).to.match(/^[0-9a-f-]{36}$/);",
                  "    pm.expect(r.name).to.eql(`test-dev-${run}`);",
                  "    pm.expect(r.rewrite_path).to.eql({replace_from: `/test-service-${run}/`, replace_to: '/'});",
                  "    pm.expect(new Date(r.created_at).getTime()).to.not.be.NaN;",
                  "});",
                  "pm.collectionVariables.set('route-id', r.id);"
                ]
              }
            }
          ]
