              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const isRoute = (r) => {",
                  "    pm.expect(r).to.have.all.keys('id', 'name', 'path', 'uri', 'rewrite_path', 'description', 'created_at');",
                  "    pm.expect(r.id).to.match(/^[0-9a-f-]{36}$/);",
