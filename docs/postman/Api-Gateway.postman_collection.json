    {
      "name": "http-logs",
      "item": [
        {
          "name": "search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway-url}}/{{gateway-admin-path}}/http-logs?page=0&size=20&from={{logs-from}}&to={{logs-to}}",
              "host": [
                "{{gateway-url}}"
              ],
              "path": [
                "{{gateway-admin-path}}",
                "http-logs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "from",
                  "value": "{{logs-from}}"
                },
                {
                  "key": "to",
                  "value": "{{logs-to}}"
                }
              ]
            },
            "description": "Every filter is optional (`page`, `size`, `status`, `method`, `query`, `route_id`, `from`, `to`); an empty one is no filter."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "//last hour (the requests of this run included); encoded, a `+` in the query is a space",
                  "const now = Date.now();",
                  "pm.collectionVariables.set('logs-from', encodeURIComponent(new Date(now - 60 * 60 * 1000).toISOString()));",
                  "pm.collectionVariables.set('logs-to', encodeURIComponent(new Date(now + 60 * 1000).toISOString()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('page shape', () => {",
                  "    pm.expect(page).to.have.all.keys('page', 'size', 'total_pages', 'total_elements', 'total_capped', 'items');",
                  "    pm.expect(page.page).to.eql(0);",
                  "    pm.expect(page.items.length).to.be.at.most(20);",
                  "});",
                  "pm.test('log shape', () => {",
                  "    pm.expect(page.total_elements, 'requests of this run are logged').to.be.above(0);",
                  "    page.items.forEach(log => {",
                  "        pm.expect(log).to.include.all.keys('id', 'source_ip', 'requested_at', 'user_agent', 'http_method', 'path', 'response_code', 'request_duration', 'route');",
                  "        pm.expect(log.response_code).to.be.a('number');",
                  "        pm.expect(log.requested_at, 'dates in UTC').to.match(/Z$/);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "search - by status, method and query",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway-url}}/{{gateway-admin-path}}/http-logs?status=4&method=post&query=ROUTES",
              "host": [
                "{{gateway-url}}"
              ],
              "path": [
                "{{gateway-admin-path}}",
                "http-logs"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "4"
                },
                {
                  "key": "method",
                  "value": "post"
                },
                {
                  "key": "query",
                  "value": "ROUTES"
                }
              ]
            },
            "description": "`status` is a prefix (`4` = 4xx); `method` and `query` ignore the case."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('only the failed POST /routes of this run and earlier', () => {",
                  "    pm.expect(page.total_elements).to.be.above(0);",
                  "    page.items.forEach(log => {",
                  "        pm.expect(log.http_method).to.eql('POST');",
                  "        pm.expect(log.response_code).to.be.within(400, 499);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "search - invalid status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway-url}}/{{gateway-admin-path}}/http-logs?status=abc",
              "host": [
                "{{gateway-url}}"
              ],
              "path": [
                "{{gateway-admin-path}}",
                "http-logs"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "abc"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('body is a Problem Details', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    const p = pm.response.json();",
                  "    pm.expect(p.status).to.eql(400);",
                  "    pm.expect(p).to.include.all.keys('type', 'title', 'status', 'detail', 'instance');",
                  "    pm.expect(p.detail).to.eql('status must be a number');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
