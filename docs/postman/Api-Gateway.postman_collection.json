              "raw": "{\n    \"name\": \"test-dev-{{run}}\",\n    \"path\": \"/test-service-{{run}}/**\",\n    \"uri\": \"http://localhost:8081\",\n    \"description\": \"A test route\",\n    \"rewrite_path\": {\n        \"replace_from\": \"/test-service-{{run}}/\",\n        \"replace_to\": \"/\"\n    }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
