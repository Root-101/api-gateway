{
  "info": {
    "_postman_id": "9e0c2056-ea60-4883-902c-3adb4e662434",
    "name": "Api-Gateway",
    "description": "Admin API of the gateway, with assertions (`pm.test`) on every request. Run it in order (Runner or `postman collection run`): the requests create, edit and delete their own routes (names with a per-run suffix, `{{run}}`), so it can run against any environment without fixed ids and leaves no data behind.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{gateway-username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{gateway-password}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "//unique suffix per run: route names/paths never clash with existing data or other runs",
          "if (!pm.collectionVariables.get('run') || pm.info.requestName === 'login') {",
          "    pm.collectionVariables.set('run', Date.now().toString(36));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "run",
      "value": ""
    },
    {
      "key": "route-id",
      "value": ""
    },
    {
      "key": "route-id-a",
      "value": ""
    },
    {
      "key": "route-id-b",
      "value": ""
    },
    {
      "key": "logs-from",
      "value": ""
    },
    {
      "key": "logs-to",
      "value": ""
    },
    {
      "key": "login-token",
      "value": ""
    }
